        "@neondatabase/serverless": "^0.10.4",
        "@unhead/vue": "^1.11.6",
        "@vuepic/vue-datepicker": "^11.0.1",
        "@vueuse/core": "^12.5.0",
        "aws-lambda": "^1.0.7",
        "cloudflare": "^3.5.0",
